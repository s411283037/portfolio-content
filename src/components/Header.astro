---
import { href } from '../lib/data';
const current = Astro.url.pathname;
const homePaths = [href(''), href('').replace(/\/$/, '')];
const prefix = homePaths.includes(current) ? '' : href('');
---
<header class="site-header" data-header>
  <a class="skip-link" href="#main">跳至主要內容</a>
  <nav class="nav shell" aria-label="主要導覽">
    <a class="wordmark" href={href('')} aria-label="許芳瑜作品集首頁">
      <span>許芳瑜</span><span aria-hidden="true">V.</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">開啟導覽選單</span><span aria-hidden="true">選單</span>
    </button>
    <div class="nav-links" id="nav-links">
      <a href={`${prefix}#about`} data-nav="about">關於</a>
      <a href={`${prefix}#experience`} data-nav="experience">經歷</a>
      <a href={`${prefix}#projects`} data-nav="projects">專案</a>
      <a href={`${prefix}#skills`} data-nav="skills">技能</a>
      <a href={`${prefix}#contact`} data-nav="contact">聯絡</a>
    </div>
  </nav>
</header>
