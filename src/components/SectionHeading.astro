---
interface Props { number: string; eyebrow: string; title: string; description?: string; }
const { number, eyebrow, title, description } = Astro.props;
---
<div class="section-heading reveal">
  <div class="section-index" aria-hidden="true">{number}</div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
</div>
