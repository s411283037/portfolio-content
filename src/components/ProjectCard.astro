---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, href } from '../lib/data';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const period = formatPeriod(project.data.period_start, project.data.period_end, project.data.ongoing);
---
<article class="project-card reveal" style={`--delay:${Math.min(index * 70, 210)}ms`}>
  <div class="project-meta">
    <span>{project.data.category}</span>
    {period && <span>{period}</span>}
  </div>
  <h3><a href={href(`projects/${project.data.id}/`)}>{project.data.title}</a></h3>
  <p>{project.data.summary}</p>
  <dl class="project-facts">
    <div><dt>我的角色</dt><dd>{project.data.role}</dd></div>
    {project.data.team_size && <div><dt>團隊</dt><dd>{project.data.team_size} 人</dd></div>}
  </dl>
  <a class="text-link" href={href(`projects/${project.data.id}/`)} aria-label={`閱讀案例：${project.data.title}`}>
    閱讀案例 <span aria-hidden="true">↗</span>
  </a>
</article>
